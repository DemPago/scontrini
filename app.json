{
  "expo": {
    "name": "scontrini",
    "slug": "scontrini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.demetrioferraro.scontrini",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "scontrini",
    "plugins": [
      "expo-mail-composer",
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve per allegare foto degli scontrini.",
          "cameraPermission": "Serve per fotografare gli scontrini."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc55d0f8-3d6e-4b6f-a3a8-eb8691c5016c"
      }
    },
    "owner": "dempagos-team"
  }
}
